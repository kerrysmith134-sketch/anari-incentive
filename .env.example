# Copy to .env for local/compose use. Values shown are development defaults.

PORT=3000
# memory (default) or postgres
STORE=memory
DATABASE_URL=postgres://anari:anari@localhost:5432/anari_incentive

# API authentication: dev (X-Tenant-Id/X-User-Id) or oidc
AUTH_MODE=dev
LOG_LEVEL=info
# Comma-separated action types that must carry approvalRequestId, e.g.
# POLICY_PUBLISH,CALCULATION_LOCK,SETTLEMENT_LOCK,LEDGER_ADJUSTMENT
REQUIRE_APPROVAL_FOR=

# OIDC (required when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Development identity defaults
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_PERSON_ID=00000000-0000-4000-8000-000000000001

# Worker
TENANT_ID=00000000-0000-4000-8000-000000000001
POLL_INTERVAL_MS=5000
SCAN_INTERVAL_MS=900000

# Worker service auth: static token or OAuth client credentials
WORKER_TOKEN=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=
