# Copy to .env for local/compose use. Values shown are development defaults.

PORT=3000
# memory (default) or postgres
STORE=memory
DATABASE_URL=postgres://anari:anari@localhost:5432/anari_incentive

# API authentication: dev (X-Tenant-Id/X-User-Id) or oidc
AUTH_MODE=dev
LOG_LEVEL=info
# Comma-separated action types that must carry approvalRequestId, e.g.
# POLICY_PUBLISH,LEGAL_GATE,CALCULATION_LOCK,SETTLEMENT_LOCK,LEDGER_ADJUSTMENT
REQUIRE_APPROVAL_FOR=
# HMAC secret per provider webhook source, e.g. WEBHOOK_SECRET_CRM
WEBHOOK_SECRET_CRM=
# Signature scheme per source: hmac (default), hubspot or feishu
WEBHOOK_SCHEME_CRM=hmac
# Require a budgetPoolId and reserve the run total for FORMAL calculations
ENFORCE_BUDGET_POOLS=false
# Optional OTLP/HTTP JSON tracing export (collector base URL)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Optional per-tenant/IP API limit per minute (0 disables)
RATE_LIMIT_PER_MINUTE=0
# Maximum request body size in bytes (defaults to 1 MiB)
BODY_LIMIT_BYTES=1048576

# OIDC (required when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Development identity defaults
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_PERSON_ID=00000000-0000-4000-8000-000000000001

# Worker
TENANT_ID=00000000-0000-4000-8000-000000000001
POLL_INTERVAL_MS=5000
SCAN_INTERVAL_MS=900000

# Worker service auth: static token or OAuth client credentials
WORKER_TOKEN=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=

# Production safety (see apps/api/src/config.ts). The API and worker refuse to
# start with NODE_ENV=production + AUTH_MODE=dev or an in-memory store unless
# these override flags are set explicitly.
# ALLOW_UNSAFE_DEV_AUTH=false
# ALLOW_MEMORY_STORE=false
# Silence the "no rate limit configured" production warning when limiting at the gateway.
# ALLOW_NO_RATE_LIMIT=false

# Feishu (Lark) integration: console SSO + directory sync.
# Set all three to enable /api/v1/auth/feishu/* sign-in and
# POST /api/v1/platform/feishu/sync-directory.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_SESSION_SECRET=            # >=16 chars; signs console session JWTs
# FEISHU_TENANT_ID=                 # tenant the sign-ins/sync belong to
# CONSOLE_BASE_URL=                 # e.g. https://incentive.example.com (for OAuth redirects)

# Account login (email + password). Required for POST /api/v1/auth/password/login.
# SESSION_SECRET=                    # >=16 chars; signs console session JWTs

# Integration webhook cryptography (production: BOTH required, >=32 chars, MUST differ).
# Signing key derives per-routing-key HMAC; raw key encrypts raw payloads at rest.
# Never reuse SESSION_SECRET. Rotate via WEBHOOK_KEY_ID + re-encryption plan.
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_RAW_KEY=
# WEBHOOK_KEY_ID=v1
# Rotation keyring (KMS/Vault sidecar can project this JSON file):
# WEBHOOK_KEYRING_FILE=/run/secrets/webhook-keyring.json
# WEBHOOK_ROTATION_CALLBACK_TOKEN=   # >=32 chars; enables POST /integration-keys/rotate
# WEBHOOK_RAW_KEYS_JSON={"v1":"old-key","v2":"new-key"}
# WEBHOOK_SIGNING_KEYS_JSON={"v1":"old-signing","v2":"new-signing"}
# SECRETS_JSON={"vault/creds":"Bearer xxx"}   # or SECRETS_FILE=/run/secrets/integration.json

# 对话意图解析（可选）：LLM 只做意图理解与人话回复，
# 金额/分数/系数仍由确定性规则引擎计算。支持 deepseek / glm / kimi / custom
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=            # custom 时必填；deepseek/glm/kimi 留空用预设
# LLM_MODEL=               # 留空用预设（deepseek-chat / glm-4.6 / kimi-k2）

# 本地系统 provider（scripts/import-local.ts）
ANARI_ERP_BASE_URL=
ANARI_ERP_TOKEN=
ANARI_COMMERCIAL_BASE_URL=
ANARI_COMMERCIAL_TOKEN=
ANARI_CRM_BASE_URL=
ANARI_CRM_TOKEN=
ANARI_TICKETING_BASE_URL=
ANARI_TICKETING_TOKEN=
ANARI_TICKETING_PROJECT_ID=
ANARI_HR_BASE_URL=
ANARI_HR_TOKEN=
ANARI_FINANCE_BASE_URL=
ANARI_FINANCE_API_KEY=
PINGCODE_BASE_URL=https://open.pingcode.com
PINGCODE_ACCESS_TOKEN=
N_PERFORM_BASE_URL=
N_PERFORM_TOKEN=
