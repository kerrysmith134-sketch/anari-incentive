{
  "name": "anari-incentive",
  "version": "0.1.0",
  "private": true,
  "description": "N-Perform \u2014 multi-party contribution attribution and incentive settlement assurance layer",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @anari/web",
    "build": "npm run typecheck && npm run web:build",
    "web:dev": "npm run dev --workspace @anari/web",
    "web:build": "npm run build --workspace @anari/web",
    "web:preview": "npm run preview --workspace @anari/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:pg": "./scripts/test-pg.sh",
    "contracts:manifest": "tsx scripts/generate-request-contracts.ts",
    "contracts:entities": "tsx scripts/generate-entity-contracts.ts && tsx scripts/generate-entity-types.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "agent:scan": "tsx scripts/agent-scan.ts",
    "sync:runner": "tsx scripts/sync-runner.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "seed:packs": "tsx scripts/seed-policy-packs.ts",
    "demo:cycle": "tsx scripts/demo-cycle.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.9.1"
  }
}
