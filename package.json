{
  "name": "anari-incentive",
  "version": "0.1.0",
  "private": true,
  "description": "N-Perform — multi-party contribution attribution and incentive settlement assurance layer",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_core_schema.sql -f db/migrations/002_governance_schema.sql -f db/migrations/003_money_path_invariants.sql -f db/migrations/004_policy_succession.sql -f db/migrations/005_ledger_sequence.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed/001_demo.sql",
    "test:pg": "./scripts/test-pg.sh",
    "reconcile": "tsx scripts/reconcile.ts",
    "agent:scan": "tsx scripts/agent-scan.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "import:csv": "tsx scripts/import-csv.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.9.1"
  }
}
